{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "split-bill",
  "compatibility_date": "2024-09-23",
  "main": "src/server/index.ts",
  "assets": {
    "directory": "./dist/client",
    // Lets the Worker fetch the built shell itself (issue #29) — it splices
    // real landing content into it for `/` instead of hand-assembling
    // <script>/<link> tags, so it stays correct as Vite's hashed asset
    // filenames change from build to build.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/" is intercepted so the Worker can serve the prerendered landing
    // document (issue #29 / ADR-0010) instead of the plain SPA shell. Every
    // other non-API path is unlisted here on purpose — it keeps falling
    // through to the static-assets layer's `not_found_handling` above,
    // which serves the minimal shell unchanged.
    "run_worker_first": ["/", "/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret model config for the parse route (issue #10). The
    // OpenRouter key and Turnstile secret are true secrets and live in
    // .dev.vars locally / `wrangler secret put` in prod, never here.
    "OPENROUTER_MODEL_DEFAULT": "google/gemini-3.1-flash-lite",
    "OPENROUTER_MODEL_ESCALATION": "google/gemini-3.5-flash",
    // Turnstile site keys are meant to be public (issue #11's Capture screen
    // hands this to the client via GET /api/config). The matching secret
    // key lives as the TURNSTILE_SECRET_KEY Worker secret, set via
    // `wrangler secret put` — never here.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBTuPKro0wwuhlN"
  },
  "ratelimits": [
    {
      "name": "PARSE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
