{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "split-bill",
  "compatibility_date": "2024-09-23",
  "main": "src/server/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
