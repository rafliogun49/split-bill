{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "split-bill",
  "compatibility_date": "2024-09-23",
  "main": "src/server/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret model config for the parse route (issue #10). The
    // OpenRouter key and Turnstile secret are true secrets and live in
    // .dev.vars locally / `wrangler secret put` in prod, never here.
    "OPENROUTER_MODEL_DEFAULT": "google/gemini-3.1-flash-lite",
    "OPENROUTER_MODEL_ESCALATION": "google/gemini-3.5-flash",
    // Turnstile site keys are meant to be public (issue #11's Capture screen
    // hands this to the client via GET /api/config). This is Cloudflare's
    // published "always passes, invisible" test key — replace with the
    // account's real site key before deploying to production.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000BB"
  },
  "ratelimits": [
    {
      "name": "PARSE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
